# ==============================================================================
# IBS AI WORKFORCE — Vercel Production Environment Variables (Template)
# Product: IBS AI Workforce | IBS Digital
# Tagline: One Company. Thirty AI Specialists. Unlimited Possibilities.
# ==============================================================================

# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Primary AI Provider: Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-flash-lite-latest

# Secondary AI Provider: Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Multi-Model Gateway: OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# Local/Private LLM: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username

# Active Engine Preference (gemini | groq | openrouter | ollama)
ACTIVE_AI_PROVIDER=gemini

# Application URL & Routing
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=/api
